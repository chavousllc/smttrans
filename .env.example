# Copy this file to .env for local development and fill in real values.
# In production (Vercel), set these as project environment variables instead.

SECRET_KEY=
FLASK_DEBUG=False

# Local dev defaults to SQLite. In production, use the Supabase pooled
# (Supavisor/pgbouncer, transaction mode) connection string on port 6543.
DATABASE_URL=sqlite:///smttrans.db

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_RECIPIENT_EMAIL=dispatch@smttrans.com
APPLICATION_RECIPIENT_EMAIL=safety@smttrans.com
